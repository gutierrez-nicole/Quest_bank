# Sensitive environment configuration
.env
.env.*
!.env.example

# Dependency & Vendor directories
vendor/
node_modules/

# Binary & archive release artifacts
*.zip
*.tar
*.tar.gz
*.sha256
release-output/
dist/

# Test & trace artifacts
playwright-report/
test-results/
coverage/
*.trace
*.webm

# Database backups (keep placeholders & protection)
database/backups/*
!database/backups/.htaccess
!database/backups/.gitkeep

# Temporary storage (keep placeholders & protection)
storage/tmp/*
!storage/tmp/.htaccess
!storage/tmp/.gitkeep

# Upload directories (keep placeholders & protection)
teacher/uploads/*
!teacher/uploads/.gitkeep
!teacher/uploads/.htaccess

uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# System, IDE & Log files
logs/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

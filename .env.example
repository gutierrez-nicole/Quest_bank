# QuestBank Environment Configuration
# Copy this file to .env and fill in the values

# AI Provider Configuration (OpenRouter or Groq)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_openrouter_or_groq_api_key_here
AI_MODEL=openai/gpt-4o

# Database Configuration (XAMPP Default)
DB_HOST=127.0.0.1
DB_NAME=bankquest_db
DB_USER=root
DB_PASS=

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly set text files to LF
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.env text eol=lf
*.htaccess text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf

# Binary files - preserve exact bytes
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary

# Files to exclude from release archives
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
